{
  "description": "Skill Improver stop hook for iterative skill improvement loop; PostToolUse hooks backing plugin-rulebook compliance checks, hooks.json schema validation, a best-effort R26 expensive-action audit on component edits/dispatches, and a best-effort R25 overhead-disclosure reminder on Agent/Bash retries; PostToolUseFailure hook feeding that same R25 reminder's failure-tracking state; PreToolUse hooks running a log-only, deterministic security pre-commit check before git commit executes, and a hard block on Agent(subagent_type: \"fork\")",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/security-precommit-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-fork-subagent.sh",
            "shell": "bash",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rulebook-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hooks-schema-check.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|Skill|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r26-expensive-action-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "^(Agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r25-overhead-disclosure-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r25-overhead-disclosure-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ]
  }
}
