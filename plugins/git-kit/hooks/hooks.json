{
  "description": "Hard-blocks raw git/gh commands that bypass git-kit's own commit/PR skills; blocks a turn from ending while a session-locked worktree holds uncommitted or unmerged work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-commit.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-pr-ops.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-branch-create.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-pr-review.sh",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-dirty-worktree-exit.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ]
  }
}
