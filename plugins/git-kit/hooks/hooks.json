{
  "description": "Hard-blocks raw git/gh commands that bypass git-kit's own commit/PR skills; blocks a turn from ending while a session-locked worktree holds uncommitted or unmerged work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-raw-commit.sh",
            "timeout": 15,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-raw-pr-ops.sh",
            "timeout": 15,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-raw-branch-create.sh",
            "timeout": 15,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-raw-pr-review.sh",
            "timeout": 15,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-raw-destructive-cleanup.sh",
            "timeout": 15,
            "onError": "warn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard-dirty-worktree-exit.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ]
  }
}
