{
  "description": "Adds a short note about when to consult the decision model, only when a usable OPENROUTER_API_KEY is in the environment or a .env file.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/dck-session-context.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      }
    ]
  }
}
