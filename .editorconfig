# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
tab_width = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4
max_line_length = 100

# Windows script files
[*.{bat,cmd,ps1}]
indent_style = tab
tab_width = 4
end_of_line = crlf

[LICENSE]
insert_final_newline = false

# Markdown files
[*.md]
trim_trailing_whitespace = false  # Preserve trailing spaces for line breaks
max_line_length = off

# Makefile and Justfile
[{Makefile,Justfile,justfile}]
indent_size = 4
tab_width = 4
indent_style = tab

# Shell scripts
[*.{bash,sh,zsh}]
indent_size = 4
tab_width = 4

# Configuration files
[*.{ini,cfg,conf}]
indent_size = 4
trim_trailing_whitespace = false

# Docker files
[Dockerfile*]
indent_size = 4

[*.dockerfile]
indent_size = 4

# Requirements files
[requirements*.txt]
indent_size = 4

# TypeScript and Javascript files
[*.{tsx,ts,mts,jsx,js,mjs,cjs}]
indent_size = 2

# Prisma schema files
[*.prisma]
indent_size = 2

# CSV files (no trailing whitespace trimming)
[*.csv]
trim_trailing_whitespace = false
