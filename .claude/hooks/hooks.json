{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python -m scripts.marketplace_ci handle-post-edit",
            "onError": "warn",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/compact-milestone-detector.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v uv >/dev/null 2>&1 && exec uv run --no-project \"${CLAUDE_PLUGIN_ROOT}\"/scripts/context-monitor.py || command -v python3 >/dev/null 2>&1 && exec python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/context-monitor.py || exec python \"${CLAUDE_PLUGIN_ROOT}\"/scripts/context-monitor.py",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rulebook-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hooks-schema-check.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|Skill|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r26-expensive-action-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "^(Agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r25-overhead-disclosure-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs\" SessionStart",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/compact-session-init.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v uv >/dev/null 2>&1 && exec uv run --no-project \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-compact-restore.py || command -v python3 >/dev/null 2>&1 && exec python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-compact-restore.py || exec python \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-compact-restore.py",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs\" SessionEnd",
            "timeout": 12,
            "onError": "warn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 600,
            "onError": "warn",
            "statusMessage": "Running Codex stop-time review gate (can take up to 9 minutes)..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/compact-stop-check.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-dirty-worktree-exit.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/compact-track-and-suggest.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-commit.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-pr-ops.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-branch-create.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-pr-review.sh",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-raw-destructive-cleanup.sh",
            "timeout": 5,
            "onError": "warn"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/security-precommit-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/compact-instructions.sh",
            "shell": "bash",
            "timeout": 5,
            "onError": "warn"
          },
          {
            "type": "command",
            "command": "command -v uv >/dev/null 2>&1 && exec uv run --no-project \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre-compact.py || command -v python3 >/dev/null 2>&1 && exec python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre-compact.py || exec python \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre-compact.py",
            "shell": "bash",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/r25-overhead-disclosure-check.sh",
            "timeout": 10,
            "onError": "warn"
          }
        ]
      }
    ]
  }
}
