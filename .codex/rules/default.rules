# Codex exec policy rules.
#
# Copy to ~/.codex/rules/default.rules. Rules govern requests to run commands
# outside the sandbox; hooks and sandboxing still matter for in-sandbox commands.

# Sentinel: shows whether Codex loaded this project rules file (see README "Checking that project
# rules load" and hooks/tests/test-live-codex-hook-and-rules.sh). Forbids only this command, also
# with more arguments after it.
# Leave it out of a ~/.codex/rules copy, or the live check can no longer tell the layers apart.
prefix_rule(
    pattern = ["echo", "CODEX_PROJECT_RULE_TEST"],
    decision = "forbidden",
    justification = "PROJECT RULE LOADED",
)

# System commands and shell utils
# Prefix rules match whole tokens, so only common spellings are listed here;
# the PreToolUse hook catches other combined flags such as `-rfv`.
prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-rF", "-fR", "-RF", "-FR", "-Fr", "-rfv", "-fRv", "-Rfv", "-vrf", "-vRf"]],
    decision = "forbidden",
    justification = "Use `trash` instead of recursive force deletion.",
    match = ["rm -rf build", "rm -fr tmp", "rm -fR tmp", "rm -rfv tmp"],
)
prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"], ["-f", "--force"]],
    decision = "forbidden",
    justification = "Use `trash` instead of recursive force deletion.",
    match = ["rm -r -f build", "rm --recursive --force tmp"],
)
prefix_rule(
    pattern = ["rm", ["-f", "--force"], ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "Use `trash` instead of recursive force deletion.",
    match = ["rm -f -r build", "rm --force --recursive tmp"],
)
# PowerShell parameters can appear in any order, so only the leading-flag
# forms can be forbidden; every other Remove-Item call asks first.
prefix_rule(
    pattern = [["Remove-Item", "ri", "del", "erase", "rd"], ["-Recurse", "-r", "-Force"]],
    decision = "forbidden",
    justification = "Recursive or forced deletion is not allowed from Codex.",
    match = ["Remove-Item -Recurse -Force build", "ri -r tmp"],
)
prefix_rule(
    pattern = [["Remove-Item", "ri", "del", "erase", "rd"]],
    decision = "prompt",
    justification = "Ask before deleting files from PowerShell.",
    match = ["Remove-Item build -Recurse -Force"],
)
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "sudo is not allowed from Codex; run it manually.",
    match = ["sudo make install"],
)
prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Filesystem formatting commands are not allowed from Codex.",
    match = ["mkfs /dev/disk1"],
)
prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Raw disk write commands are not allowed from Codex.",
    match = ["dd if=image.iso of=/dev/disk1"],
)
prefix_rule(
    pattern = ["killall"],
    decision = "forbidden",
)
prefix_rule(
    pattern = ["shutdown"],
    decision = "forbidden",
)
prefix_rule(
    pattern = ["reboot"],
    decision = "forbidden",
)
# World-writable modes, with up to two flags before the mode.
prefix_rule(
    pattern = ["chmod", ["777", "0777", "1777", "2777", "666", "0666", "a+rwx", "a=rwx", "ugo+rwx", "ugo=rwx", "a+w", "o+w", "go+w"]],
    decision = "forbidden",
    justification = "World-writable permissions are not allowed from Codex.",
    match = ["chmod 777 build", "chmod 0777 x", "chmod 1777 dir", "chmod 666 f", "chmod a=rwx x", "chmod go+w x"],
    not_match = ["chmod 755 build", "chmod +x script.sh", "chmod 644 f"],
)
prefix_rule(
    pattern = ["chmod", ["-R", "--recursive", "-f", "-v"], ["777", "0777", "1777", "2777", "666", "0666", "a+rwx", "a=rwx", "ugo+rwx", "ugo=rwx", "a+w", "o+w", "go+w"]],
    decision = "forbidden",
    justification = "World-writable permissions are not allowed from Codex.",
    match = ["chmod -R 777 build", "chmod --recursive a+w x"],
)
prefix_rule(
    pattern = ["chmod", ["-R", "--recursive", "-f", "-v"], ["-R", "--recursive", "-f", "-v"], ["777", "0777", "1777", "2777", "666", "0666", "a+rwx", "a=rwx", "ugo+rwx", "ugo=rwx", "a+w", "o+w", "go+w"]],
    decision = "forbidden",
    justification = "World-writable permissions are not allowed from Codex.",
    match = ["chmod -R -v 777 x"],
)
prefix_rule(
    pattern=[["bash", "sh"], ["-lc", "-c"]],
    decision="prompt",
    justification="Shell wrappers can hide compound commands; require explicit approval.",
)
# External network and containers
prefix_rule(
    pattern = [["npm", "pnpm", "bun"], "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["npm publish", "npm publish --tag next", "pnpm publish", "bun publish"],
)
prefix_rule(
    pattern = ["yarn", "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["yarn publish"],
)
prefix_rule(
    pattern = ["yarn", "npm", "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["yarn npm publish"],
    not_match = ["yarn npm info react"],
)
prefix_rule(
    pattern = [["lerna", "changeset"], "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["lerna publish from-package", "changeset publish"],
)
# Flag-first monorepo forms. Forms with a value before `publish`
# (`npm -w pkg publish`, `pnpm --filter pkg publish`) cannot be written as a
# prefix rule; the PreToolUse hook blocks those.
prefix_rule(
    pattern = ["pnpm", ["-r", "--recursive"], "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["pnpm -r publish", "pnpm --recursive publish --access public"],
)
prefix_rule(
    pattern = ["npm", ["--workspaces", "-ws"], "publish"],
    decision = "forbidden",
    justification = "Publishing packages is not allowed from Codex; publish manually.",
    match = ["npm --workspaces publish", "npm -ws publish"],
)
# Download-and-run tools: each fetches a package and executes it.
prefix_rule(
    pattern = [["npx", "bunx", "uvx"]],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["npx prettier --check .", "bunx eslint .", "uvx ruff check"],
)
prefix_rule(
    pattern = ["npm", ["exec", "x"]],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["npm exec -- prettier .", "npm x eslint"],
)
prefix_rule(
    pattern = [["pnpm", "yarn"], "dlx"],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["pnpm dlx create-vite", "yarn dlx cowsay"],
)
prefix_rule(
    pattern = ["pipx", "run"],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["pipx run black ."],
)
prefix_rule(
    pattern = ["uv", "tool", "run"],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["uv tool run ruff check"],
)
prefix_rule(
    pattern = ["bun", "x"],
    decision = "prompt",
    justification = "This downloads and runs a package; ask first.",
    match = ["bun x eslint ."],
)
# Project generators download and run a `create-*` package. A bare `npm init`
# with no package name also prompts.
prefix_rule(
    pattern = ["npm", ["create", "init"]],
    decision = "prompt",
    justification = "This downloads and runs a project generator; ask first.",
    match = ["npm create vite@latest", "npm init vite"],
)
prefix_rule(
    pattern = [["pnpm", "yarn", "bun"], "create"],
    decision = "prompt",
    justification = "This downloads and runs a project generator; ask first.",
    match = ["pnpm create vite", "yarn create next-app", "bun create hono"],
)
prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "Ask before external network requests.",
)
prefix_rule(
    pattern = ["wget"],
    decision = "prompt",
    justification = "Ask before external network requests.",
)
prefix_rule(
    pattern = ["Invoke-WebRequest"],
    decision = "prompt",
    justification = "Ask before external network fetches.",
)
prefix_rule(
    pattern = [["iwr", "irm", "Invoke-RestMethod"]],
    decision = "prompt",
    justification = "Ask before external network fetches.",
)
# Only read-only compose subcommands are allowed. The strictest matching rule
# wins, so a blanket `docker compose` prompt would override these allows;
# the mutating subcommands are listed instead. A subcommand in neither list
# runs sandboxed and escalates through the normal approval path.
prefix_rule(
    pattern = ["docker", "compose", ["ps", "logs"]],
    decision = "allow",
    justification = "Read-only docker compose inspection.",
    match = ["docker compose ps", "docker compose logs web"],
)
prefix_rule(
    pattern = ["docker", "compose", ["up", "down", "run", "exec", "start", "stop", "restart", "rm", "kill", "build", "pull", "push", "create", "cp"]],
    decision = "prompt",
    justification = "Compose can delete volumes or mount the host from an edited compose file; ask first.",
    match = ["docker compose up -d", "docker compose down --volumes"],
)
prefix_rule(
    pattern = ["docker", "pull"],
    decision = "prompt",
    justification = "Ask before downloading Docker images.",
)
prefix_rule(
    pattern = ["docker", "run"],
    decision = "prompt",
    justification = "Ask before running Docker containers.",
)
# Git mutations
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Do not force-push unless the user explicitly requested it.",
    match = ["git push --force origin feature"],
)
prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Do not force-push unless the user explicitly requested it.",
    match = ["git push -f origin feature"],
)
prefix_rule(
    pattern = ["git", "push", ["--force-with-lease", "--force-if-includes"]],
    decision = "forbidden",
    justification = "Do not force-push unless the user explicitly requested it.",
    match = ["git push --force-with-lease origin feature"],
)
prefix_rule(
    pattern = ["git", ["clean", "checkout", "restore", "rm", "config"]],
    decision = "prompt",
    justification = "These commands can discard work or change repository config; ask first.",
    match = ["git clean -ffdx", "git checkout -- file", "git restore .", "git rm file", "git config user.name"],
)
prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Removing a worktree can discard its uncommitted work; ask first.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard work unless the user explicitly requested it.",
    match = ["git reset --hard HEAD"],
)
prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master"]],
    decision = "forbidden",
    justification = "Use feature branches and PRs; do not push directly to main/master.",
    match = ["git push origin main", "git push origin master"],
)
prefix_rule(
    pattern = ["git", "push", "origin", "HEAD", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "Force-pushing is prohibited even for the current task branch.",
)
prefix_rule(
    pattern = ["git", "push", "--set-upstream", "origin", "HEAD", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "Force-pushing is prohibited even while setting upstream.",
)
prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-fdx", "-df", "-dfx", "-xf", "-xfd"]],
    decision = "forbidden",
    justification = "Destructive clean operations can delete untracked work.",
)
# No blanket `git pull` rule: a bare `git pull` matches nothing, runs
# sandboxed without network, and Codex asks to escalate. `git pull --ff-only`
# prompts (see the allowlist section below).
prefix_rule(
    pattern = ["git", "pull", ["--rebase", "-r", "--no-ff", "--squash", "--no-rebase"]],
    decision = "forbidden",
    justification = "Merging or rebasing pulls must be run manually outside Codex.",
    match = ["git pull --rebase", "git pull --no-ff origin main"],
)
prefix_rule(
    pattern = ["git", "merge"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Ask before running git push.",
)
prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "forbidden",
    justification = "Amending can rewrite already-published history.",
)
prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Ask before running git commit.",
)
prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "filter-branch"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "branch", "-d"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "branch", "--delete"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "tag", "-d"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "reflog", "expire"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "reflog", "delete"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "stash"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "clone"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
prefix_rule(
    pattern = ["git", "revert"],
    decision = "forbidden",
    justification = "This command must be run manually outside Codex.",
)
# GH cli commands
prefix_rule(
    pattern = ["gh", "workflow", ["run", "enable", "disable"]],
    decision = "forbidden",
    justification = "The owner starts and toggles workflows manually.",
)
prefix_rule(
    pattern = ["gh", "run", ["rerun", "cancel", "delete"]],
    decision = "forbidden",
    justification = "The owner reruns and cancels workflow runs manually.",
)
prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Prints the stored GitHub token.",
)
prefix_rule(
    pattern = ["gh", ["secret", "variable"]],
    decision = "forbidden",
    justification = "Secrets and variables are managed by the owner in GitHub.",
)
prefix_rule(
    pattern = ["gh", "pr", ["create", "merge", "close"]],
    decision = "forbidden",
)
prefix_rule(
    pattern = ["gh", "issue", "close"],
    decision = "prompt",
    justification = "Ask before closing an issue.",
)
prefix_rule(
    pattern = ["gh", "issue", ["create", "edit"]],
    decision = "prompt",
    justification = "Ask before creating or editing an issue.",
)
prefix_rule(
    pattern = ["gh", "api", "graphql"],
    decision = "prompt",
    justification = "GraphQL calls can run mutations; ask first.",
)
# `gh api` can reach what the forbidden gh rules block (workflow dispatch,
# secrets, variables, repo administration). Every call asks; a method flag in
# first position is forbidden outright. `gh api <path> -X DELETE` and `-f`
# (implicit POST) still only ask: prefix rules cannot see later arguments.
prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "REST calls can mutate repository state; ask first.",
    match = ["gh api repos/o/r", "gh api repos/o/r -X DELETE"],
)
prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], ["POST", "PUT", "PATCH", "DELETE", "post", "put", "patch", "delete"]],
    decision = "forbidden",
    justification = "Mutating REST calls must be run manually outside Codex.",
    match = ["gh api -X DELETE repos/o/r", "gh api --method POST repos/o/r/dispatches"],
)
prefix_rule(
    pattern = ["gh", "api", ["--method=POST", "--method=PUT", "--method=PATCH", "--method=DELETE", "-XPOST", "-XPUT", "-XPATCH", "-XDELETE"]],
    decision = "forbidden",
    justification = "Mutating REST calls must be run manually outside Codex.",
    match = ["gh api --method=DELETE repos/o/r", "gh api -XPOST repos/o/r"],
)
prefix_rule(
    pattern = ["gh", "repo", ["delete", "archive", "rename", "edit"]],
    decision = "forbidden",
    justification = "Repository administration must never be performed by an autonomous coding task.",
)
# Allowlist
#
# An `allow` rule runs its command OUTSIDE the sandbox without prompting, so
# list only commands that genuinely need to leave it (network access, or
# writes to tool caches outside the workspace). Local read-only tools (cat,
# grep, ls, sed, ...) already run inside the sandbox without a prompt; allowing
# them here would only let them bypass the profile's deny-read rules. A
# command that runs workspace-controlled code (git hooks, build backends) or
# takes an arbitrary output path is a prompt rule, not an allow rule.
prefix_rule(
    pattern = ["git", "fetch", "--prune"],
    decision = "prompt",
    justification = "Trailing arguments such as --upload-pack can run a command; ask first.",
)
prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "prompt",
    justification = "A fast-forward runs the post-merge hook, which reads the working-tree pre-commit config; ask first.",
)
prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "prompt",
    justification = "`--show-token`/`-t` prints the stored GitHub token; ask first.",
    match = ["gh auth status", "gh auth status --show-token", "gh auth status -t"],
)
prefix_rule(pattern=["gh", "issue", ["list", "view", "status"]], decision="allow")
prefix_rule(pattern=["gh", "label", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", ["diff", "list", "view", "checks", "status"]], decision="allow")
prefix_rule(pattern=["gh", "repo", ["list", "view"]], decision="allow")
prefix_rule(pattern=["gh", "run", ["list", "view", "watch"]], decision="allow")
prefix_rule(pattern=["gh", "search"], decision="allow")
prefix_rule(pattern=["gh", "status"], decision="allow")
prefix_rule(pattern=["gh", "workflow", ["list", "view"]], decision="allow")
prefix_rule(
    pattern = ["uv", ["build", "export", "lock", "sync", "tree"]],
    decision = "prompt",
    justification = "uv can run project build code or write to an arbitrary output path; ask first.",
    match = ["uv build --native-tls", "uv export -o requirements.txt", "uv sync --locked"],
)
