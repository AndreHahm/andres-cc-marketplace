# .env / .env.* deliberately NOT mirrored from .gitignore above: those
# patterns exist to keep untracked env files out of git, but secretlint
# only ever scans files the changed-files step already reports as
# tracked/changed -- a force-added (`git add -f`) .env file with a real
# credential would otherwise sail through this scan with a false-clean
# result (Codex finding, round 2).
.idea
.qodo
.windsurf
.github\instructions\codacy.instructions.md
*.local
*.local.*
