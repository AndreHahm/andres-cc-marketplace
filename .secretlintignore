*.snap
*.pdf
*.zip
*.gz
*.tar

# repo-specific
pnpm-lock.yaml
uv.lock
.env.example
# Anchored to repo root (leading /) -- an unanchored bare name matches at any
# depth in gitignore syntax, which previously also exempted
# plugins/analysis-kit/tests/ and plugins/session-kit/tests/ from scanning,
# not just these top-level directories (issue #295).
/.agents
/.claude
/.codex
/.devin
/tests
# Verified via a real `secretlint --format json` run against every file that
# was previously listed here (63 total, issue #295): only the two entries
# below actually trigger a finding (fake Slack tokens / a fake Postgres
# connection string used as documentation/test fixtures). The other three
# don't trip secretlint's content scan, but their filename matches the same
# */secret/*|*credential*/ pattern plugins/git-kit/scripts/scan-staged-files.sh
# and codex-kit's guarded-dispatch.mjs use (via the shared
# plugins/codex-kit/scripts/lib/secret-filenames.mjs pattern list) -- kept so
# a future integration making those two tools consult this file doesn't
# regress on them. The remaining 58 originally-listed files matched neither
# check and were removed.
plugins/plugin-devkit/skills/skill-development/references/secrets-and-credentials.md
plugins/analysis-kit/scripts/redact_secrets.py
plugins/codex-kit/scripts/lib/secret-filenames.mjs
plugins/codex-kit/scripts/smoke-tests/codex-exec-secret-redaction.mjs
plugins/codex-kit/scripts/smoke-tests/git-untracked-secret-screen.mjs

# .gitignore (repo root)
# node_modules, npm-debug.log, .venv, __pycache__, *.pyc, .pytest_cache,
# .ruff_cache, .ty, dist, build, reports/events, *.local/*.local.*/
# **/*.local.*, **/.draft, **/.backup, **/.temp, **/.experiments, and
# **/.claude-plugin/*.lock were removed from this list (issue #295):
# all are genuinely gitignored (never appear as a "changed" file unless
# force-added), and *.local/npm-debug.log specifically are the same class
# of risk .env already was -- a force-added file that could carry a real
# credential -- so exempting them here would silently reopen the same gap
# the .env removal below already closed (Codex finding, round 2).
# .env / .env.* deliberately NOT mirrored from .gitignore above: those
# patterns exist to keep untracked env files out of git, but secretlint
# only ever scans files the changed-files step already reports as
# tracked/changed -- a force-added (`git add -f`) .env file with a real
# credential would otherwise sail through this scan with a false-clean
# result (Codex finding, round 2).
.github/instructions/codacy.instructions.md
